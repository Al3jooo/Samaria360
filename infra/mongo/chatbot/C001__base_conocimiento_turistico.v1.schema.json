{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "contenido",
      "categoria",
      "fechaActualizacion"
    ],
    "additionalProperties": false,
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "contenido": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "categoria": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "fechaActualizacion": {
        "bsonType": "date"
      }
    }
  }
}
