<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot 3.5.16: última versión OSS de la línea 3.x (Entregable 1 fija "Spring Boot 3").
      La línea 3.5 terminó soporte OSS el 30/06/2026: decisión registrada en ADR-010.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.unimagdalena.samaria360</groupId>
    <artifactId>ms-auth</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ms-auth</name>
    <description>Samaria360 - Microservicio de autenticación (arquitectura hexagonal)</description>

    <properties>
        <java.version>17</java.version>
        <!-- No gestionadas por el BOM de Spring Boot: versión explícita -->
        <springdoc.version>2.10.0</springdoc.version>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencies>
        <!-- ============ Adaptador de entrada: API REST ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <!-- Validación de DTOs de entrada (@NotBlank, @Email) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============ Adaptador de salida: persistencia PostgreSQL ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- Alcance compile (no runtime): RestriccionesUnicas lee el nombre de la restricción violada del campo
                 estructurado del error (PSQLException.getServerErrorMessage().getConstraint()), no del texto del
                 mensaje (registro, ADR-006). Misma dependencia; solo cambia el alcance. -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Migraciones versionadas del esquema auth_db (V1__, V2__...) -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <!-- Desde Flyway 10 el soporte de PostgreSQL es un módulo aparte -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ============ Adaptador de seguridad: BCrypt (RNF05) + JWT RS256 ============ -->
        <dependency>
            <!-- Incluye spring-security-crypto (BCryptPasswordEncoder) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <!-- Nimbus JOSE: NimbusJwtEncoder para emitir tokens y JwtDecoder para validarlos.
                 ms-catalog y ms-booking usan la misma librería para validar vía JWKS; el API Gateway no valida
                 el JWT (ADR-005). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ============ Adaptadores de salida: mensajería y correo ============ -->
        <dependency>
            <!-- Nivel 3 de ADR-003: publicación de eventos en RabbitMQ con outbox y publisher confirms (ADR-011,
                 DEC-284). Versión gestionada por Spring Boot. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <!-- Correo por SMTP directo de ms-auth (figura 20 del Entregable 2; RF34, DEC-278, DEC-282). Versión
                 gestionada por Spring Boot. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ============ Operación y contrato ============ -->
        <dependency>
            <!-- /actuator/health para los healthchecks de docker-compose -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- Contrato OpenAPI del servicio (evidencia para la Vista de Implementación) -->
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ============ Pruebas ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- PostgreSQL real en pruebas de integración del adaptador JPA -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- RabbitMQ real en las pruebas del relevo de eventos (ADR-011, «Cumplimiento»). Versión del BOM de
                 Testcontainers que gestiona Spring Boot. -->
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Valida cada evento publicado contra docs/sad/api/eventos.schema.json (JSON Schema 2020-12; ADR-011,
                 «Cumplimiento»). Solo pruebas. -->
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.8</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Reglas que fallan si domain/ o application/ dependen de Spring o JPA -->
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Cobertura de las pruebas (evidencia de calidad para el SAD). Es un plugin de compilación: no agrega
                     dependencias a la aplicación ni cambia el jar. Informe en target/site/jacoco/index.html tras
                     ./mvnw verify; ./mvnw test no lo genera. -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <executions>
                    <execution>
                        <id>preparar-agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>informe</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
