# Copiar a .env (que está en .gitignore) y cambiar las contraseñas.
# docker-compose.yml exige POSTGRES_USER, POSTGRES_PASSWORD, MONGO_USER y MONGO_PASSWORD.

# Frontend (nginx) en Docker Compose: http://localhost:8000
FRONTEND_PORT=8000

# Perfiles de Docker Compose: dev agrega Mailpit, el servidor SMTP de desarrollo (DEC-282; bandeja en
# http://localhost:8025). En la demo se deja vacío y se configura el SMTP de Gmail (SMTP_*).
COMPOSE_PROFILES=dev

POSTGRES_USER=samaria
POSTGRES_PASSWORD=cambiar_esto
# Puerto publicado en 127.0.0.1. Si el PostgreSQL de Windows ya usa el 5432, poner 5433.
POSTGRES_PORT=5432
# Host de PostgreSQL para ./mvnw (por defecto localhost). Docker Compose lo fija en "postgres".
# POSTGRES_HOST=localhost

MONGO_USER=samaria
MONGO_PASSWORD=cambiar_esto
MONGO_PORT=27017

# Usuarios propios de cada servicio (DEC-275, mínimo privilegio). POSTGRES_USER y MONGO_USER quedan como
# administradores: solo los usan postgres-bases y mongo-migraciones, que crean y actualizan estos usuarios en cada
# arranque. Cada servicio se conecta con el suyo: ms-auth solo a auth_db, ms-booking solo a reservas_db y ms-catalog
# con readWrite solo en catalog_db.
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=cambiar_esto
BOOKING_DB_USER=booking_app
BOOKING_DB_PASSWORD=cambiar_esto
CATALOG_DB_USER=catalog_app
CATALOG_DB_PASSWORD=cambiar_esto
# ms-analytics (DEC-292): readWrite solo en analytics_db.
ANALYTICS_DB_USER=analytics_app
ANALYTICS_DB_PASSWORD=cambiar_esto
# ms-chatbot (DEC-297): readWrite solo en chatbot_db.
CHATBOT_DB_USER=chatbot_app
CHATBOT_DB_PASSWORD=cambiar_esto
# Host de MongoDB para ./mvnw (por defecto localhost). Docker Compose lo fija en "mongo".
# MONGO_HOST=localhost

# ms-auth
# La vigencia del token es fija (15 minutos, DEC-29 / ADR-008) y ya no se configura aquí.
# Rutas relativas a la carpeta del servicio (ms-auth/), desde donde se ejecuta ./mvnw spring-boot:run.
# En Docker Compose las llaves se montan como secrets en /run/secrets/ (no se usan estas rutas).
JWT_LLAVE_PRIVADA=../infra/keys/jwt-privada.pem
JWT_LLAVE_PUBLICA=../infra/keys/jwt-publica.pem

# Relevo de cuentas de ms-auth hacia ms-catalog y ms-booking (ADR-008; URI de los endpoints internos, no son secretos).
# Valores por defecto para ./mvnw; Docker Compose usa los nombres de la red interna.
# CATALOG_INTERNO_URI=http://localhost:8082
# BOOKING_INTERNO_URI=http://localhost:8083

# ms-catalog (usa MONGO_USER, MONGO_PASSWORD y MONGO_PORT; la contraseña va codificada para URL si tiene caracteres especiales)
AUTH_JWKS_URI=http://localhost:8081/api/v1/auth/.well-known/jwks.json

# ms-booking (usa POSTGRES_* y AUTH_JWKS_URI; consulta el detalle público de ms-catalog antes de reservar y para
# materializar la oferta en el inventario bajo demanda, DEC-135)
MS_CATALOG_URL=http://localhost:8082

# RabbitMQ (ADR-011, DEC-284): administrador de la consola (http://localhost:15672) y un usuario por servicio.
RABBITMQ_USER=samaria
RABBITMQ_PASSWORD=cambiar_esto
RABBITMQ_AUTH_PASSWORD=cambiar_esto
RABBITMQ_BOOKING_PASSWORD=cambiar_esto
RABBITMQ_CATALOG_PASSWORD=cambiar_esto
RABBITMQ_ANALYTICS_PASSWORD=cambiar_esto
RABBITMQ_CHATBOT_PASSWORD=cambiar_esto
# Host de RabbitMQ para ./mvnw (por defecto localhost). Docker Compose lo fija en "rabbitmq".
# RABBITMQ_HOST=localhost

# Correo de ms-auth (RF34, DEC-282). Con el perfil dev, Mailpit (valores por defecto). En la demo, Gmail con una
# contraseña de aplicación: SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=587, SMTP_TLS=true, SMTP_USUARIO y SMTP_CLAVE.
# Nunca se versiona ni se escribe en los logs.
# SMTP_HOST=mailpit
# SMTP_PUERTO=1025
# SMTP_USUARIO=
# SMTP_CLAVE=
# SMTP_TLS=false
# CORREO_REMITENTE=no-responder@samaria360.local
# Origen de la SPA para el enlace del correo de recuperación (en la demo, https://samaria360.duckdns.org).
# FRONTEND_URL=http://localhost:8000

# Secretos de los clientes internos de ms-auth (DEC-280): cada servicio pide un JWT de servicio con el suyo.
SERVICIO_ANALYTICS_SECRETO=cambiar_esto
SERVICIO_BOOKING_SECRETO=cambiar_esto

# Asistente virtual (decisión 5 del equipo, DEC-297): LLM_PROVEEDOR=reglas (por defecto, sin llave) o gemini con
# GEMINI_API_KEY (nunca en el repositorio ni en los logs; el nivel gratuito puede usar lo enviado para entrenar: el
# asistente no envía datos personales).
# LLM_PROVEEDOR=reglas
# GEMINI_API_KEY=
# Modelo sin razonamiento y de respuesta rápida (el adaptador corta a los 8 s). gemini-2.5-flash ya no se ofrece a
# las cuentas nuevas (404) y los modelos que razonan gastan los 400 tokens antes de escribir (DEC-315).
# GEMINI_MODELO=gemini-3.5-flash-lite

# api-gateway (valores para el arranque local con ./mvnw; Docker Compose usa los nombres de la red interna)
AUTH_URI=http://localhost:8081
CATALOG_URI=http://localhost:8082
BOOKING_URI=http://localhost:8083
CORS_ORIGENES=http://localhost:5173
